within ModelicaTest.Electrical.PowerConverters;
model DiodeCenterTapmPulse_5Phase = Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierCenterTapmPulse.DiodeCenterTapmPulse(m=5)
  "Variant of DiodeCenterTapmPulse with m=5 phases"
  annotation (experiment(StopTime=0.1, Tolerance=1e-06, Interval=0.0002), Documentation(info="<html>
<p>
Variant of <a href=\"modelica://Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierCenterTapmPulse.DiodeCenterTapmPulse\">DiodeCenterTapmPulse</a> with m=5 phases.
</p>
</html>"));
